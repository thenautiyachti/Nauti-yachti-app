# dependencies / build output
node_modules
.next
out

# local database leftovers (the app uses Postgres; these are stale artifacts)
dev.db
dev.db-journal
prisma/dev.db
prisma/dev.db-journal

# secrets and local-only config -- never commit these
.env
.env.local
.env.*.local
.env.production
conf/
*.pem
*.key

# logs and OS cruft
*.log
desktop.ini
.DS_Store

# Generated packages for other businesses. Rebuilt on demand by
# scripts/make-distributable.js -- never committed, because a stale copy in the
# repository is exactly the fork this design exists to avoid.
/../distributable/
