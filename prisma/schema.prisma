generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Package {
  id            String  @id
  name          String
  pricingType   String // "hourly-by-vessel" | "per-guest" | "tiered-by-guests" | "flat"
  unit          String?
  blurb         String
  bulletsIntro  String?
  bulletsJson   String? // JSON string: string[]
  closing       String?
  linkLabel     String?
  linkUrl       String?
  image         String?
  price         Float? // used when pricingType = "flat"
  pricePerGuest Float? // used when pricingType = "per-guest"
  fixedHours    Int? // used when pricingType = "per-guest" or "tiered-by-guests"
  // What to SAY the duration is, when a single number would be a lie.
  //
  // Boatz & Glowz runs 4-6 hours depending on the night — lines off at 7pm and
  // back around midnight, which was never the "4 hours" fixedHours claimed.
  // fixedHours stays an integer because it is a number other things reason
  // about; this is the label, and it wins wherever a duration is shown.
  //
  // Null for every package with an honest single figure.
  durationLabel String?
  eventDate     String? // used when pricingType = "per-guest" (e.g. Boatz & Glowz)
  tiersJson     String? // JSON string: { max: number, price: number }[]
  hourlyJson    String? // JSON string: { [vesselId]: { weekday: {...}, weekend: {...} } }
  vesselsJson   String // JSON string: string[] of vessel ids this package can use
  sortOrder     Int     @default(0)
}

// Audit trail for Packages & Pricing changes — internal only, never shown
// on the public site. Lets the owner investigate a pricing discrepancy
// after the fact (what changed, from what, to what, when).
model PriceChangeLog {
  id          String   @id @default(cuid())
  packageId   String
  packageName String // denormalized snapshot — stays readable even if the package is later renamed
  field       String // human-readable description, e.g. "Flat price", "Per-guest price", "Nauti Explorer / weekend / 4hr", "Tier 2 (13-16 guests)"
  oldValue    Float?
  newValue    Float
  changedAt   DateTime @default(now())
}

model Vessel {
  id        String  @id
  slip      String
  name      String
  capacity  Int
  // Does this boat have an engine-hour meter?
  //
  // It decides what a row in EngineHoursLog MEANS for this vessel. With a
  // meter, hours is a reading off the dial and the current value is the latest
  // one. Without, the owner logs the length of each charter and the current
  // value is all of them added up. Two of the three have no meter, so false is
  // the honest default. See lib/engineHours.js.
  hasHourMeter Boolean @default(false)
  // WHERE THIS BOAT LIVES. There is not one dock.
  //
  // The Explorer is at Pearl Bay on the east side; the Islander and the Yachti
  // are three miles WSW. Ten minutes apart at cruise, which in weather is the
  // difference between making it and not — so "the run home" is a question
  // about a boat, not about the business, and a single DOCK_LAT/DOCK_LON would
  // have routed two of the three fleet to the wrong shore.
  //
  // Null falls back to DOCK_LAT/DOCK_LON, then to the middle of the lake.
  dockLat   Float?
  dockLon   Float?
  note      String
  image     String?
  sortOrder Int     @default(0)
}

model GalleryItem {
  id        String @id
  image     String
  caption   String
  category  String // matches a Package id
  sortOrder Int    @default(0)
  // Real pixel size of the source photo, read from the file header when the
  // item is added. The gallery lays out justified rows from these, which it
  // cannot do without knowing each photo's shape before it loads.
  width     Int?
  height    Int?
}

model BlockedDate {
  id       String @id @default(cuid())
  vesselId String
  date     String // "YYYY-MM-DD"

  @@unique([vesselId, date])
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  packageId   String
  packageName String
  vesselId    String?
  vesselName  String?
  date        String?
  hours       Int?
  partySize   String?
  message     String?
  priceQuoted Float?
  status      String   @default("new") // "new" | "lapsed" | "pending" | "booked" | "completed" | "cancelled"
  submittedAt DateTime @default(now())

  paymentStatus         String  @default("unpaid") // "unpaid" | "paid" | "refunded"

  // How the money arrived. Same vocabulary and same rule as ExternalBooking:
  // asserted, never inferred. A website inquiry is almost always Stripe, but
  // "almost always" is exactly the assumption that filed card income as cash.
  paymentMethod         String?
  stripeSessionId       String?
  stripePaymentIntentId String?

  // A PAYMENT THAT WAS TRIED AND DID NOT WORK.
  //
  // Sarah Griffith tried to pay for two glow seats at 10:47pm on 12 Sep 2026 and
  // her bank declined it for insufficient funds. This row read "new / unpaid" —
  // true, and identical to somebody who never opened the link. The webhook only
  // ever listened for success, so the attempt existed nowhere but in Stripe, and
  // the owner found it by going and looking himself.
  //
  // A guest who tried and was stopped by her bank needs "your seats are still
  // there, try another card". A guest who never tried needs a nudge. Without
  // these two columns they are the same row.
  //
  // CLEARED when a payment finally succeeds: a paid booking must never still be
  // wearing the decline from the attempt before it.
  paymentFailedAt    DateTime?
  paymentFailedError String? // plain English — see lib/paymentFailure.js

  // Only meaningful when status is "cancelled" — how a confirmed booking's
  // payment was resolved on cancellation. Independent of paymentStatus
  // (which is the raw Stripe-driven unpaid/paid/refunded signal); this
  // captures the owner's own record of what actually happened.
  refundType   String? // "full" | "partial" | "none"
  refundAmount Float? // dollar amount actually refunded — mainly for "partial"

  // WHERE THIS PERSON CAME FROM, captured rather than guessed.
  //
  // ExternalBooking has carried referralSource for a while, but it is filled in
  // by hand and only 11 of 76 rows have one. An Inquiry had nothing at all — so
  // somebody who arrived from an Instagram DM, a link in bio or a QR code on
  // the boat produced a record that could not say which.
  //
  // Set from a `?from=` (or `utm_source`) parameter on the landing URL and
  // carried through the form, so a DM that sends people to
  // /packages/tubing-wakeboarding-charter?from=ig-tube is measurable. It is the
  // difference between "did the automation bring anything in" being a fact and
  // being a guess, which is what decides whether to build more of them.
  //
  // Free text on purpose: the campaign tags are invented as campaigns are, and
  // a fixed list here would be stale within a month.
  referralSource String?

  couponCode     String? // uppercase Coupon.code, if one was applied at checkout
  discountAmount Float? // dollars knocked off priceQuoted by the coupon

  // Gift certificate applied at checkout, after any coupon. giftAmount is the
  // dollars drawn off the certificate for this booking.
  giftCertificateCode String?
  giftAmount          Float?

  // Format "NY-YYYYMMDD-NN" — assigned at creation time going forward only.
  // Historical rows are intentionally left null (never backfilled) — see
  // lib/bookingId.js for the generator.
  bookingId String? @unique

  addOnIds          String? // JSON string: string[] of AddOn ids selected at booking
  reviewRequestedAt DateTime? // when a Google review was asked for; null = not yet asked

  // When the guest's booking confirmation actually went out. Null means it did
  // NOT, which is a different thing from "we think it probably did".
  //
  // This column exists because of a specific failure. sendBookingConfirmationEmail
  // returns { sent: false, reason } when it cannot send — and every caller threw
  // that away with `.catch(() => {})`, which does not even catch a returned
  // value. So on 5 Sep 2026 the first real card payment produced a paid booking,
  // a created charter, and silence: no mail to the guest, none to the owner who
  // is CC'd on the same send. The code knew exactly why and told nobody.
  //
  // A returned failure is only as good as its reader. Written down, the
  // invariant becomes checkable in one query — paid, and no confirmation — which
  // is what scripts/check-output.js asks every morning.
  confirmationSentAt DateTime?
  // Never ask this person for a review. ExternalBooking has carried this for a
  // while; contacts needed it too, because "do not ask" is a decision about a
  // person, not about which table they happen to live in.
  marketingOptOut   Boolean   @default(false)

  // When the guest ticked the terms box at checkout. A tick that is not
  // recorded proves nothing: if the release is ever tested, what matters is
  // being able to show WHO accepted and WHEN. Null means this booking predates
  // the checkbox, which is different from someone having declined.
  termsAcceptedAt DateTime?
}

model Coupon {
  id                     String   @id @default(cuid())
  code                   String   @unique // stored uppercase, e.g. "FAMILY20"
  discountType           String // "percent" | "fixed"
  discountValue          Float // 20 means 20% for percent, or $20 for fixed
  active                 Boolean  @default(true)
  maxUses                Int?
  usedCount              Int      @default(0)
  expiresAt              String? // "YYYY-MM-DD"
  note                   String?
  requiresReturningGuest Boolean  @default(false) // if true, checkCoupon() only accepts this code for an email with a prior paid Inquiry
  archived               Boolean  @default(false) // soft-delete — removed from the main admin list into an Archived section, restorable
  createdAt              DateTime @default(now())
}

model Subscription {
  id           String   @id @default(cuid())
  name         String // e.g. "Boat storage", "design.com domain", "Claude subscription"
  category     String? // e.g. "Storage", "Hosting", "Software", "Utilities"

  // NULL MEANS NOBODY HAS FOUND OUT WHAT IT COSTS. Zero means it is free.
  //
  // Those were the same value until 13 Sep 2026, when checking the platform
  // accounts turned up services that genuinely cost nothing — Supabase is on the
  // free plan and Vercel on a personal account — alongside several whose price
  // is simply unknown. Showing both as "0" would have made a confirmed $0 look
  // like an unanswered question and an unanswered question look like it was free.
  amount       Float?
  billingCycle String // "monthly" | "yearly" | "weekly"
  nextDueDate  String? // "YYYY-MM-DD"
  vendor       String?
  note         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // PERSONAL, NOT THE BUSINESS'S — kept here on purpose and counted nowhere
  // near it.
  //
  // The owner wanted one place to see every subscription he pays for, personal
  // ones included, so duplicates and waste can be found across the lot. The
  // hazard is obvious and is the one his own bookkeeping rule already names:
  // personal spending that drifts into business deductions. Netflix has no
  // business share to argue about — it is simply not the business's, and a
  // percentage is the wrong instrument for saying so.
  //
  // So this is a hard partition rather than a label or a 0%. A personal row is
  // excluded from the monthly cost, the deductible figure, the tax report and
  // the unanswered-question warnings; it appears only in its own section with
  // its own totals. Nothing that reaches an accountant can see it.
  personal     Boolean  @default(false)

  // WHICH ADDRESS THIS BILL BELONGS TO.
  //
  // The business moved in April 2026, so for most of the tax year there are TWO
  // of everything: two water accounts, two electricity suppliers, two internet
  // providers, two storage sites. Without this, a year's bills read as one
  // continuous run of duplicated services and nothing says which address was
  // live when.
  premises String?

  // When the account opened and closed. endedOn is the fact; `active` is the
  // flag the console filters on, and the two must agree -- an account with an end
  // date that still counts as active goes on inflating the monthly total forever.
  startedOn String? // "YYYY-MM-DD"
  endedOn   String? // "YYYY-MM-DD" — null means still running

  // HOW MUCH OF THIS IS ACTUALLY THE BUSINESS'S.
  //
  // The office is at home, so the household utilities are deductible only in the
  // proportion the business uses -- not in full. Boat storage is the opposite:
  // it is 100% business and nothing about it is a home-office question.
  //
  // NULL MEANS NOBODY HAS DECIDED YET, and that is deliberately different from
  // zero. The Tax Report used to annualise every subscription at its full amount,
  // which for a household water bill is a claim the business never had. An unset
  // share is excluded from the deductible total and counted as unanswered, so it
  // shows up as a question rather than quietly becoming a number.
  businessUsePct Float?

  // Account or reference number, so a statement can be matched to the right one
  // of two accounts with the same vendor at different addresses.
  accountRef String?
}

model ExternalBooking {
  id         String   @id @default(cuid())
  vesselId   String
  vesselName String
  date       String // "YYYY-MM-DD"
  startTime  String? // "HH:MM" 24-hour, e.g. "10:00" — when the charter starts
  hours      Int? // charter length; used to gauge how much of the day is taken
  guestName  String?
  email      String? // guest email, when known — Boatsetter/GetMyBoat rarely expose a real one
  partySize  Int?
  platform   String // "Boatsetter" | "GetmyBoat" | "Facebook" | "Instagram" | "Other"
  status     String   @default("booked") // see lib/bookingStatus.js — that file, not this comment, is the vocabulary: "inquiry" | "lapsed" | "booked" | "owed" | "completed" | "cancelled"
  note       String?
  createdAt  DateTime @default(now())

  pricePaid Float? // what the guest actually paid, if the owner has logged it

  // WHAT THEY ASKED FOR, AND WHAT IT COSTS — so a booking taken by text can be
  // sent the same checkout link as one taken on the website.
  //
  // Added 11 Sep 2026. Until then /pay/<id> resolved against Inquiry only, so
  // the guests this table exists for — the ones who booked by text, WhatsApp or
  // at the dock, which is most of them — were the only ones who could not be
  // sent a link to pay. The owner's rule: "I want all inquiry texts to contain a
  // check out link, like Brian's ... based on their inquiry selection."
  //
  // priceQuoted is deliberately NOT pricePaid. pricePaid is money received;
  // this is money asked for. Charging from pricePaid would mean a booking is
  // owed whatever it has already paid.
  packageId       String?
  packageName     String?
  priceQuoted     Float?
  // Mirrors Inquiry so the webhook and the pay page can treat both the same.
  paymentStatus   String  @default("unpaid") // "unpaid" | "paid" | "refunded"
  stripeSessionId String?

  // Mirrors Inquiry's pair — see the long note there. A /pay link can be
  // declined exactly the same way, and a platform booking awaiting a card is
  // just as invisible when it is.
  paymentFailedAt    DateTime?
  paymentFailedError String?

  // HOW THE MONEY ARRIVED. See lib/channels.js for the vocabulary.
  //
  // Added 11 Sep 2026 because nothing recorded it, so the ledger was inferring
  // it from `platform` — and called a Stripe payment "Cash". The owner's rule:
  // "The only way to capture cash payments would be me telling u they paid in
  // cash, no other way to confirm it really." So this is ASSERTED, never
  // guessed. Null means nobody has said yet, which is a better answer than a
  // confident wrong one.
  paymentMethod String?

  phone             String? // the PRIMARY number — what gets texted by default
  // Everyone else on the booking, as JSON: [{ number, label }].
  //
  // Parties book for each other. Oscar's 6 Sep charter carried his name and his
  // email but a party member's phone, because that is who filled the form, and
  // the gate code went to a number the owner did not recognise. One column
  // cannot hold "sometimes multiple numbers are collected in a booking", and
  // overwriting `phone` to correct it destroys the original with no audit
  // trail. See lib/bookingPhones.js — never parse this by hand.
  phonesJson        String?
  platformRef       String? // the platform's own reservation number (Boatsetter/GetMyBoat) - shared key with LedgerEntry
  referralSource    String? // how the booking was won: "repeat guest", "word of mouth", "website", "walk-up" - distinct from `platform`, which is who processed it
  reviewRequestedAt DateTime? // when a Google review was asked for; null = not yet asked
  // WHEN THE GUEST'S BOOKING CONFIRMATION ACTUALLY WENT OUT. Null means it did
  // NOT, which is a different thing from "we think it probably did".
  //
  // Inquiry has carried this since 5 Sep 2026 and this table did not, so the
  // morning check could only ever ask the question of website bookings. The
  // bookings taken by text — which is most of them, and the entire reason this
  // table exists — were the ones it could not see.
  //
  // That is not theoretical. Jim Gonzalez paid $100 for two glow seats, was
  // never emailed anything at all, and sat paid-and-silent for a week without
  // appearing on a single list. He was found by the owner asking, on the day
  // before the charter.
  confirmationSentAt DateTime?

  // When the gate code was texted for this charter; null = not yet sent.
  //
  // The dock page listed arriving guests with a "Text them the gate code"
  // button and recorded nothing when it was pressed. On 6 Sep 2026 the owner
  // sent Oscar his code twenty minutes before an 11am charter, and the card sat
  // there afterwards looking exactly as it had before -- no confirmation, no
  // change. His question was the right one: does it go away, or sit forever?
  // It sat until the date rolled past, which is the worst of both, because the
  // honest answer to "did I already send this?" was "look in your texts".
  gateCodeSentAt    DateTime?
  marketingOptOut   Boolean       @default(false)
  ledgerEntries     LedgerEntry[]

  // Format "NY-YYYYMMDD-NN" — assigned at creation time going forward, and
  // backfilled once (2026-08-29) for historical rows so every booking has one.
  bookingId String? @unique
}

model AddOn {
  id        String  @id
  name      String
  price     Float
  unit      String? // e.g. "per charter", "per bottle"
  blurb     String?
  sortOrder Int     @default(0)
  active    Boolean @default(true) // false = hidden from the public site (e.g. temporarily out of stock) but still manageable in the admin console
  archived  Boolean @default(false) // true = removed from the main admin list into the Archived section; also implies hidden from the public site
}

model LedgerEntry {
  id                String           @id @default(cuid())
  type              String // "income" | "expense"
  category          String? // e.g. "01. Gas" (expense) or "Reservation" (income)
  subcategory       String? // vessel/package name for income rows, e.g. "The Nauti Explorer" — null for expenses
  amount            Float
  grossAmount       Float? // income rows only: the platform's gross/list price before its commission — amount is what was actually paid out. Nullable/optional; not used for expenses.
  note              String?
  origin            String? // reservation origin (Boatsetter, GetmyBoat, ...) or statement source (Cash, Wells Fargo Statement, ...)
  bookingId         String? // links an expense back to the reservation it was for
  externalBookingId String? // real FK to ExternalBooking.id - the reliable join the bookingId string never provided
  externalBooking   ExternalBooking? @relation(fields: [externalBookingId], references: [id], onDelete: SetNull)
  date              String
  createdAt         DateTime         @default(now())
}

// Places on the lake worth being able to find from the water: fuel docks,
// somewhere to get under cover, ramps.
//
// DELIBERATELY OWNER-ENTERED. Being wrong about a fuel dock is expensive in a
// specific way — a boat runs a tank down heading somewhere that turns out not
// to pump gas, or not on a Tuesday, or not since last season. Coordinates
// recalled from nowhere in particular are not worth that risk, and the owner
// runs this lake every week. Captured by standing somewhere and tapping once,
// which is also the least typing possible on a boat. See lib/waterPoints.js.
model WaterPoint {
  id        String   @id @default(cuid())
  // "fuel" | "shelter" | "ramp" | "spot" | "stumps" | "shallow" | "nowake"
  kind      String
  name      String
  lat       Float
  lon       Float
  // How far the thing extends, in yards. A fuel dock is a point and leaves this
  // null; a stump field is not. "The north end above 1375 is stumps" is an AREA,
  // and marking it as a pin would say the hazard is one spot and the water
  // beside it is fine.
  //
  // A circle is a crude shape for a stump field. It is deliberately crude: the
  // owner is dropping it from memory or from the helm, and a circle he can
  // actually judge the size of beats a polygon that implies a survey.
  radiusYards Int?
  // Safe-harbor detail. These are the four things the owner said decide whether
  // a borrowed slip is actually usable when a storm catches you out:
  //
  //   covered    lightning is the reason to go, so an open slip is barely worth
  //              the trip
  //   onProperty whether it hangs off somebody's house, which changes entirely
  //              how welcome an unannounced boat is
  //   permission "yes" | "no" | "asked" — has anyone actually asked. A "no" is
  //              never recommended whatever the weather is doing
  //   motorized  whether the slip has a lift, which usually means it is spoken
  //              for even when it looks empty
  //
  // Null everywhere means unknown, which is different from false and is why
  // these are nullable rather than defaulted.
  covered     Boolean?
  onProperty  Boolean?
  permission  String?
  motorized   Boolean?
  note      String?
  createdAt DateTime @default(now())
}

model MaintenanceItem {
  id             String  @id @default(cuid())
  // Which boat this belongs to. null = the whole fleet (a trailer, a shared
  // spare), judged against the hardest-worked engine as everything used to be.
  //
  // This was one shared checklist for all three boats, which was the right call
  // while no hours had ever been logged and stopped being right the moment they
  // were: an oil change belongs to an engine, not to a company. Judging the
  // Islander's oil against the Explorer's 120 hours reports it overdue for work
  // its own engine has not earned. See lib/maintenance.js.
  vesselId       String?
  label          String
  intervalHours  Int?
  intervalMonths Int?
  lastDoneDate   String? // "YYYY-MM-DD"
  lastDoneHours  Float?
  notes          String?
  sortOrder      Int     @default(0)
}

model EngineHoursLog {
  id        String   @id @default(cuid())
  vesselId  String
  date      String // "YYYY-MM-DD"
  // Means one of two things, depending on Vessel.hasHourMeter: a meter READING
  // on a boat that has a dial, or the DURATION of one charter on a boat that
  // does not. Never read this column directly — lib/engineHours.js knows which
  // is which, and getting it wrong makes an engine appear to run backwards.
  hours     Float
  note      String?
  createdAt DateTime @default(now())
}

// WHAT A GUEST SENT US, AND WHETHER IT HAS COME HOME YET.
//
// The website takes media from guests: they pick the charter they were on, say
// who they are, and upload straight to storage. The file never passes through
// the app -- a 240MB phone video cannot fit in a serverless request body, and
// one clip off the glasses on 19 Sep was 239MB.
//
// THIS ROW IS THE ACCOUNTABILITY. An upload page that anybody can find is a
// drop box for whatever the internet feels like sending, so every file arrives
// with a name, a number, a charter and a consent timestamp attached, and the
// bucket is private so nothing is readable on the web even by URL. Nothing is
// ever posted from here: it lands in the inbox and goes through the same
// approval the glasses footage does.
//
// consentAt is not decoration either. Posting a guest's video is a use of their
// material, and "they sent it in" is a weaker answer than a recorded tick
// against a named charter -- the same reasoning as termsAcceptedAt on a booking.
model GuestUpload {
  id            String   @id @default(cuid())
  // Who says they sent it. Not verified, which is exactly why it is recorded.
  uploaderName  String
  uploaderPhone String
  uploaderEmail String?

  // Which night it belongs to. eventKey is the folder it lands in; eventLabel
  // is what the guest saw when they picked it. A charter that is not on the
  // list gets eventKey "other" and whatever they typed in eventLabel.
  eventKey      String
  eventLabel    String
  // Set only when the phone matches a booking on that date. It is a hint for
  // the owner, never a claim -- a party often books on one person's number.
  bookingId     String?

  fileName      String
  storagePath   String   @unique
  sizeBytes     Int
  contentType   String

  consentAt     DateTime
  // Kept for abuse, not analytics. An open upload endpoint needs to be able to
  // answer "where did this come from" exactly once, after something goes wrong.
  userAgent     String?

  // "pending" until the file is confirmed in the bucket, "uploaded" once it is,
  // "pulled" once it reaches 00 Inbox on the owner's machine, "rejected" if he
  // throws it out. Never deleted: the record of a bad upload is the point.
  status        String   @default("pending")
  pulledAt      DateTime?
  note          String?

  createdAt     DateTime @default(now())

  @@index([eventKey, status])
}

model FuelLog {
  id            String   @id @default(cuid())
  vesselId      String
  date          String // "YYYY-MM-DD"
  hoursAtFillup Float?
  gallons       Float?
  cost          Float?
  note          String?
  createdAt     DateTime @default(now())
}

model MediaDraft {
  // One social pipeline: proposed -> approved -> scheduled -> posted.
  // Previously this table held only agent-proposed drafts while a separate
  // CampaignPost table held scheduled copy, so approving a draft was a dead
  // end - it set a flag and nothing carried it to a date. Both halves now live
  // here, which also leaves the media-agent cron POSTing to /api/media-drafts
  // working unchanged.
  id         String    @id @default(cuid())
  theme      String // package name or "General" this is themed around
  mediaUrl   String? // null for a written-in-advance campaign post with no image yet
  mediaType  String    @default("image") // "image" | "video"
  caption    String // Drafted social caption text
  platform   String? // intended platform, e.g. "instagram", "facebook", "tiktok" — nullable, may be undecided
  status     String    @default("proposed") // pipeline stage: "proposed" | "approved" | "scheduled" | "posted" | "rejected"
  reviewNote String? // optional owner note when approving/rejecting

  // WHY a draft was sent back or killed, as one of a fixed set of reasons.
  //
  // Asked for on 8 Sep 2026: "if I select don't post, should I disclose why so
  // it can be ruled why it didn't work?" Until then DENY recorded nothing at
  // all — a post vanished from the queue and the reason lived only in the
  // owner's head, so the same mistake could be proposed again the next week and
  // nobody could count how often it happened.
  //
  // Separate from reviewNote on purpose. The note is prose for whoever rewrites
  // the draft; this is the countable half — "six of the last ten were killed
  // for the wrong clip" is a fact you can act on, and free text will not give
  // it to you.
  //
  // Vocabulary lives in lib/reviewReasons.js, not here.
  reviewReason String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  // Scheduling half of the pipeline, merged in from CampaignPost.
  campaign      String? // e.g. "boatz-and-glowz-2026-09"; null for a one-off
  postNumber    Int? // ordering within a campaign
  title         String? // the beat, e.g. "FINAL CALL"
  scheduledDate String? // "YYYY-MM-DD" once it has a slot
  scheduledTime String? // "6:30 PM"
  photoHint     String? // which real photo to use
  deliveryNote  String? // e.g. "post natively - Blotato cannot do IG stills"
  postedAt      DateTime?
  postUrl       String?

  @@index([campaign, scheduledDate])
  @@index([status])
}

model CommentReplyDraft {
  // A suggested reply waiting in the box, so answering a comment is editing a
  // sentence rather than starting from a blank field at eleven at night.
  //
  // WHY THIS IS A TABLE AND NOT GENERATED IN THE BROWSER. The console has no
  // model access; the crew do. Siren reads the comments on her run and leaves a
  // suggestion here, exactly the way Coral leaves a MediaDraft. The owner then
  // types over it or sends it.
  //
  // IT IS NEVER SENT ON ITS OWN. The one time this really mattered, a comment
  // read "Just using my photo with no heads up huh??" and the confident answer
  // — that the image was AI-generated — was false: the file still had Samsung
  // camera Exif on it. A suggestion that posts itself would have published
  // that. So this table holds text for a human to look at, nothing more.
  id        String   @id @default(cuid())
  // Blotato's comment id, which is what the console keys replies on.
  commentId String   @unique
  platform  String // "facebook" | "instagram"
  // What the comment said when the suggestion was written. If the thread has
  // moved on since, the suggestion is stale and the console says so rather
  // than pre-filling an answer to a different question.
  commentText String?
  suggestion  String
  author      String   @default("Nauti Siren")
  createdAt   DateTime @default(now())
  // Set when the owner sends a reply to this comment, so a used suggestion
  // stops reappearing.
  usedAt DateTime?

  @@index([platform])
}

model Testimonial {
  id              String    @id @default(cuid())
  name            String
  rating          Int // 1-5
  quote           String
  packageOrVessel String? // e.g. "Party Cove on the Nauti Yachti" — optional
  status          String    @default("pending") // "pending" | "approved" | "rejected"
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  // The day they actually sailed, shown beside the name. Separate from
  // submittedAt, which is when the review was written -- often months later.
  charterDate     String? // "YYYY-MM-DD"
}

model SpeechEvent {
  id        String   @id @default(cuid())
  text      String // the text that was spoken
  audioB64  String? // ElevenLabs mp3 output, base64-encoded; null when synthesis failed (quota) and only the text was kept
  createdAt DateTime @default(now())
}

model AgentActivity {
  id          String    @id @default(cuid())
  agentName   String // e.g. "Claude Code", "Media Agent"
  taskTitle   String
  status      String    @default("running") // "running" | "completed" | "failed"
  detail      String? // free text — a short progress note or result summary
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model JarvisTodo {
  id        String    @id @default(cuid())
  text      String
  priority  String    @default("medium") // "low" | "medium" | "high"
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  doneAt    DateTime?
}

// Prepaid money with a depleting balance — deliberately NOT a Coupon. A coupon
// is a discount rule; a gift certificate is cash taken up front for a service
// still owed, which makes an unredeemed balance a liability rather than income.
model GiftCertificate {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "NY-GIFT-7QK4M2", stored uppercase
  initialAmount   Float // face value at issue
  balance         Float // what is left; a certificate can be part-redeemed
  purchaserName   String?
  purchaserEmail  String?
  purchaserPhone  String?
  recipientName   String?
  message         String? // the note that goes on the printed certificate
  status          String   @default("active") // "active" | "redeemed" | "void"
  expiresAt       String? // "YYYY-MM-DD"; null means no expiry
  stripeSessionId String? // set when bought online rather than issued by hand
  note            String?
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  redemptions GiftCertificateRedemption[]
}

// One row per draw-down, so a balance can always be explained rather than
// merely asserted — the difference between "it says $50" and "here is where
// the other $450 went".
model GiftCertificateRedemption {
  id            String          @id @default(cuid())
  certificateId String
  certificate   GiftCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  amount        Float
  bookingId     String? // the booking it was applied to, when known
  note          String?
  redeemedAt    DateTime        @default(now())
}

// A scheduled social post, one row per post AND platform.
//
// Split per platform rather than one row carrying three captions, because each
// goes out separately: Blotato cannot push a still image to the Instagram feed,
// so IG stills are posted by hand while Facebook goes through the API. A single
// status per post would hide "done on Facebook, still owed on Instagram".
model CampaignPost {
  id            String    @id @default(cuid())
  campaign      String // e.g. "boatz-and-glowz-2026-09"
  postNumber    Int // ordering within the campaign
  scheduledDate String // "YYYY-MM-DD"
  scheduledTime String? // "6:30 PM"
  title         String?
  platform      String // "Facebook" | "Instagram" | "TikTok"
  body          String // the caption, ready to copy
  photoHint     String? // which real photo to use
  deliveryNote  String? // e.g. "post natively - Blotato cannot do IG stills"
  status        String    @default("pending") // "pending" | "posted" | "skipped"
  postedAt      DateTime?
  postUrl       String?
  createdAt     DateTime  @default(now())

  @@index([campaign, scheduledDate])
}

// A guest asking for their photographs, from the QR code on the boat.
//
// WHY THIS EXISTS. 17 of 39 completed charters have no phone and no email on
// file, so they can never be asked for a review, invited back, or sent anything.
// Every attempt to fix that downstream failed for the same reason: you cannot
// contact somebody to ask for their contact details.
//
// So the ask moves to the boat. A guest who has just spent four hours being
// filmed has a real reason to scan a code, and the contact detail arrives as a
// by-product rather than as a request.
//
// The review link sits on the same page and is NEVER conditional on this. Google
// and Facebook both prohibit incentivised reviews, and Google's 2026 policy
// carries civil penalties per violation. Photographs are delivered to everyone
// who asks, whatever they do or do not write.
model PhotoRequest {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  // The day they sailed. Prefilled from the QR link where possible, because a
  // guest should not have to remember a date they are standing in.
  charterDate String? // "YYYY-MM-DD"
  note        String? // anything they typed
  createdAt   DateTime @default(now())

  // Set when the photographs have actually been sent. Deliberately nullable and
  // deliberately not defaulted: an unfulfilled promise should be visible.
  sentAt   DateTime?
  sentNote String? // how, and what was sent
}

// What the bank actually said, on the day somebody looked.
//
// The ledger can tell you what was earned and spent. It cannot tell you what is
// IN the account, because it has never known about transfers between accounts,
// the owner's own deposits, or a fee the bank took without telling anyone. On
// 31 Aug 2026 this account sat at MINUS $11.36 and two Optimum payments had
// bounced, and nothing in this system could have said so.
//
// ONE ROW PER READING, not one row per account. A single mutable balance would
// answer "what is it now" and lose "what was it in August", and the August
// answer is the one that explains the twelve-dollar service charge. The current
// balance is simply the newest reading for that account.
//
// IT IS A READING, NOT A DERIVED FIGURE. Nothing recalculates it, and it does
// not reconcile against LedgerEntry. That is the honest shape for something
// typed in off a screenshot: it is only ever as true as the day it was taken,
// so `asOf` is required and the console shows its age rather than presenting a
// stale number as current.
model BankBalanceReading {
  id      String @id @default(cuid())
  // "Woodforest Business Checking". Written out, because this is read aloud in
  // status briefs and an abbreviation is not.
  account String
  // Last four only. Never the full number: this database is backed up, exported
  // to a bookkeeper, and read by eight agents.
  last4   String?
  balance Float
  asOf    String // "YYYY-MM-DD" — the date the balance was true, not the date it was typed

  // Where the figure came from, so a screenshot reading is never mistaken for a
  // reconciled statement: "screenshot" | "statement" | "manual".
  source String @default("manual")
  note   String?

  createdAt DateTime @default(now())

  @@index([account, asOf])
}

// A SUGGESTED REPLY WAITING IN A DM BOX.
//
// The sibling of CommentReplyDraft, and it exists because the Messages tab was
// built to the same SHAPE as Comments but never got the same plumbing. Same
// card, same textarea, same Send — and nothing that ever filled the box. On
// 17 Sep 2026 a guest asked "Hey bub, you got any seats open for Saturday?"
// two hours before the owner looked, and the box under it was empty, because no
// crew brief had ever mentioned a DM.
//
// KEYED ON THE CONVERSATION, not on a message. The console's box is per thread
// — SocialMessagesTab keys its drafts on thread.id — so one live suggestion per
// thread is the shape that matches what a person sees. This is deliberately
// simpler than the comment path, which keys on a comment id and has to walk the
// reply chain to find the one being answered: a DM thread has exactly one place
// to type.
//
// Upsert on conversationId, for the same reason Siren upserts a comment
// suggestion: she runs every morning, and a thread she has read twice should
// end with ONE suggestion reflecting her latest read rather than a pile the
// console has to choose between.
model MessageReplyDraft {
  id             String @id @default(cuid())
  conversationId String @unique
  platform       String // "facebook" | "instagram"

  // The incoming message this answers. Not decoration: if they write again
  // after the draft was written, the suggestion may be answering a question
  // that has been overtaken, and the console says so instead of pre-filling it
  // silently. Same hazard the comment path hit when a comment was edited.
  messageId   String?
  messageText String?

  suggestion String
  author     String   @default("Nauti Siren")
  createdAt  DateTime @default(now())

  // Set when the owner sends, so a suggestion he has already acted on stops
  // coming back into the box.
  usedAt DateTime?
}

// A THREAD THE OWNER ANSWERED SOMEWHERE ELSE.
//
// Blotato only sees messages sent through Blotato. He answers most DMs from the
// Facebook app on his phone, and those replies never sync back — so on
// 17 Sep 2026 two threads he had personally answered still showed the red
// NEVER ANSWERED flag, one of them for ten days. The console was not wrong
// about its data; its data was missing half the conversation.
//
// This is the half a person supplies. It is a note in our own console and has
// NOTHING to do with the Blotato automation: marking a thread answered does not
// stop their next message getting an automatic reply, because that fires on
// message-received at the platform and never looks here.
//
// KEYED ON THE CONVERSATION, TIMED ON THE ANSWER. The thread counts as answered
// only while `answeredAt` is newer than the last thing they said. Write again
// and it re-opens on its own, which is the behaviour the owner asked for and
// the reason this stores a time rather than a boolean.
model MessageThreadAnswer {
  id             String  @id @default(cuid())
  conversationId String  @unique
  platform       String?

  // The incoming message that had been answered, recorded for the audit trail.
  // The comparison itself is on answeredAt, which survives a message id
  // changing under us the way Blotato's trigger ids do on a republish.
  answeredMessageId String?
  answeredAt        DateTime @default(now())

  // Where he answered it, when he says. "the Facebook app" is the usual one.
  answeredWhere String?
  note          String?
}

// =============================================================================
// AGENCY — creator account management
// =============================================================================
//
// A SECOND BUSINESS IN THE SAME DATABASE, AND DELIBERATELY SEALED OFF FROM THE
// FIRST. Everything above this line is the charter business. Everything below
// it is the model-management agency bought from InnerWifi on 18 Sep 2026.
//
// They share a Postgres instance and nothing else. That is not tidiness, it is
// the contract: clause 4 of the Inner Wifi Sales Agreement takes 2.5% of agency
// revenue monthly and expressly excludes "business ventures unrelated to the
// Model management industry". Charter income is one of those ventures. A single
// query that ever swept a LedgerEntry into an agency revenue total would be
// handing over 2.5% of the boats, forever. So no model below relates to a model
// above, and lib/agency/* reads only from Agency* tables.
//
// MONEY IS INTEGER CENTS HERE, not Float as in LedgerEntry. The charter ledger
// records amounts somebody already agreed on; this one DERIVES amounts by
// multiplying by percentages four times in a row — platform fee, creator split,
// royalty, partner split — and float drift across that chain is what produces a
// payout that disagrees with its own statement by a penny and a phone call
// about it. Percentages are basis points for the same reason: 3333 bp, not
// 0.3333.

// Somebody whose account we run, and whose media we are waiting on.
//
// Two names, deliberately. `stageName` is what appears on the platform and on
// every screen in this console. `legalName` exists because a payout and a tax
// form need the name on the bank account, and because 18 U.S.C. § 2257 requires
// the producer of sexually explicit content to hold the performer's legal name
// and date of birth on record. It is stored once, shown rarely, and is the
// reason AgencyComplianceRecord exists at all.
model AgencyCreator {
  id        String @id @default(cuid())
  stageName String
  legalName String?
  email     String?
  phone     String?

  // "prospect" | "onboarding" | "active" | "paused" | "offboarded"
  //
  // Only "active" creators are chased for content. Only creators who are or
  // once were active can be owed money — an offboarded creator with an unpaid
  // balance stays visible precisely because leaving is when people get
  // forgotten.
  status String @default("prospect")

  // DATE OF BIRTH, and the whole reason this is not optional in practice.
  //
  // Every piece of content this agency publishes needs the performer to have
  // been over 18 on the day it was PRODUCED, not on the day it was posted.
  // Holding the date lets lib/agency/compliance.js answer that per submission
  // instead of per person. Null means the creator cannot be published or paid;
  // see payableState().
  dateOfBirth String? // "YYYY-MM-DD"

  // What they keep, and of what.
  //
  // splitBasis decides which number the percentage applies to, and it is the
  // single most misunderstood term in this industry. "net" means after the
  // platform's own cut (OnlyFans takes 20%); "gross" means off the fan's
  // payment before it. A 50% deal on gross pays the creator 62.5% of what
  // actually arrives, and an agency that signed one of those on the assumption
  // it meant net is losing money on every post. Stored per creator because
  // deals differ, and shown in both forms wherever it is edited.
  creatorShareBp Int    @default(5000) // basis points: 5000 = 50.00%
  splitBasis     String @default("net") // "net" | "gross"

  // How they get paid, and what we are allowed to send.
  payoutMethod    String? // "ach" | "paypal" | "wise" | "crypto" | "check"
  payoutHandle    String? // account reference — last4, email, or wallet label
  payoutCurrency  String  @default("USD")
  // Below this, a payout rolls into next period instead of being sent. Small
  // transfers cost more in fees and bookkeeping than they move.
  payoutMinCents  Int     @default(5000)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        AgencyAccount[]
  complianceDocs  AgencyComplianceRecord[]
  contentRequests AgencyContentRequest[]
  payouts         AgencyPayout[]
}

// One account on one platform. A creator can have several.
model AgencyAccount {
  id        String        @id @default(cuid())
  creatorId String
  creator   AgencyCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform String @default("onlyfans") // "onlyfans" | "fansly" | "instagram" | ...
  handle   String
  // "building" | "live" | "paused" | "closed"
  status   String @default("building")
  launchedOn String? // "YYYY-MM-DD"

  // What the platform itself takes, before anybody here splits anything.
  // OnlyFans is 20% and has been for years, but it is stored rather than
  // hardcoded because Fansly is not, and because a rate that changes should
  // change in one row and not in a constant somewhere.
  platformFeeBp Int @default(2000) // 2000 = 20.00%

  // How often this account is supposed to post. Drives the content pipeline:
  // an account that owes four posts a week and has two approved submissions is
  // behind, and lib/agency/pipeline.js says so by name.
  postsPerWeek Int @default(5)

  // DOES THIS ACCOUNT'S REVENUE FALL UNDER THE INNERWIFI 2.5%?
  //
  // Clause 4 excludes model-management business "that do not utilize the agency
  // & agency resources that Inner Wifi provides". Whether a given account used
  // those resources is a question of fact that is easy to answer in the week it
  // is signed and nearly impossible to reconstruct two years later in a dispute.
  //
  // So it is decided once, here, with a written reason. Defaults to true
  // because assuming coverage is the safe error: underpaying a royalty is a
  // breach, overpaying is a refund claim.
  royaltyCovered Boolean @default(true)
  royaltyNote    String? // why, in words, for whoever reads this during an audit

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earnings        AgencyEarning[]
  contentRequests AgencyContentRequest[]

  @@unique([platform, handle])
}

// The paperwork that has to exist before a creator can be published or paid.
//
// NOT A DOCUMENT STORE. This records that a document exists, who checked it,
// when, and when it stops being valid. The documents themselves — government
// ID, signed releases, tax forms — do not belong in this database and are not
// put here: they live in the secure store this row points at by reference.
// A leaked Postgres backup should embarrass this business, not end it and
// expose the people who trusted it with a passport photo.
//
// 18 U.S.C. § 2257 puts the record-keeping duty on the producer, with the
// records held for a defined period and produced on inspection. Missing
// paperwork is not an administrative annoyance in this industry; it is the
// failure that closes the business.
model AgencyComplianceRecord {
  id        String        @id @default(cuid())
  creatorId String
  creator   AgencyCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // "government_id" | "age_verification" | "model_release" | "content_license"
  // | "tax_form" | "platform_agreement"
  kind String

  // Where the actual document lives — a vault path or document-service id,
  // never a URL anyone could follow without authenticating.
  reference String?

  verifiedBy String? // who looked at it
  verifiedAt DateTime?
  // Government ID expires. A verified record whose document lapsed is not a
  // verified record, and the difference is invisible unless somebody stores
  // this.
  expiresOn  String? // "YYYY-MM-DD"

  notes     String?
  createdAt DateTime @default(now())

  @@index([creatorId, kind])
}

// Media we have asked for and have not got yet.
//
// The thing the whole agency actually runs on, and the thing that is always
// tracked in a group chat until the day someone is owed three weeks of content
// and nobody can say since when. A request is a promise with a date on it.
model AgencyContentRequest {
  id        String        @id @default(cuid())
  creatorId String
  creator   AgencyCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  accountId String?
  account   AgencyAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  title       String
  description String?
  // "photo" | "video" | "custom" | "ppv" | "livestream"
  mediaType   String @default("photo")
  quantity    Int    @default(1)

  dueOn String? // "YYYY-MM-DD"
  // "requested" | "submitted" | "approved" | "rejected" | "published" | "cancelled"
  status String @default("requested")
  // "low" | "normal" | "urgent"
  priority String @default("normal")

  requestedAt DateTime  @default(now())
  submittedAt DateTime?
  approvedAt  DateTime?
  publishedAt DateTime?

  // Why it came back. An empty rejection is a request that gets made twice.
  rejectionReason String?

  // WHEN THE MEDIA WAS SHOT, which is not when it was sent.
  //
  // § 2257 asks whether the performer was over 18 at production. A clip filmed
  // at 17 and delivered at 19 is the case this field exists for, and the only
  // way to catch it is to record the production date and check it against the
  // creator's date of birth. lib/agency/compliance.js does exactly that and
  // blocks approval.
  producedOn String? // "YYYY-MM-DD"

  notes     String?
  updatedAt DateTime @updatedAt

  @@index([status, dueOn])
}

// A row off a platform earnings statement.
//
// IMPORTED, NEVER SCRAPED. OnlyFans publishes no third-party management API and
// its terms do not permit automating someone else's account, so this arrives
// the way the money actually arrives: a CSV exported from the account, uploaded
// here, parsed by lib/agency/statements.js. Slower than a sync and it is the
// only version of this that does not put every managed account at risk of
// termination.
//
// grossCents is what the fan paid. netCents is what reached the account after
// the platform's cut. BOTH ARE STORED rather than one being derived, because
// the statement states both and a stored figure that disagrees with an imported
// one is a discrepancy worth seeing rather than a rounding rule worth guessing.
model AgencyEarning {
  id        String        @id @default(cuid())
  accountId String
  account   AgencyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Calendar month this belongs to, "YYYY-MM". The royalty is monthly, the
  // partner draw is monthly, so the period is the unit everything settles in.
  period String

  // "subscription" | "tip" | "ppv" | "message" | "stream" | "referral" | "other"
  //
  // Worth separating because subscriptions are the residual and the rest is
  // not. An agency whose revenue is 80% tips has a good month; one whose
  // revenue is 80% subscriptions has a business.
  kind String @default("subscription")

  grossCents      Int
  platformFeeCents Int
  netCents        Int

  earnedOn String  // "YYYY-MM-DD"
  // Where the row came from, so a bad import can be found and undone as a unit.
  importBatch String?
  externalRef String? // the statement's own id for this line, if it has one

  createdAt DateTime @default(now())

  @@index([accountId, period])
  @@index([importBatch])
}

// What the agency spent. Subtracted before the royalty and before the partners.
//
// This is the number that decides how much clause 4 costs, under the reading
// where 2.5% attaches to net profit. Which means every expense left out of here
// is money the agency pays InnerWifi for no reason, and every expense wrongly
// put in here is a royalty underpayment. It deserves more care than it usually
// gets.
model AgencyExpense {
  id     String @id @default(cuid())
  period String // "YYYY-MM"

  // "chatter" | "va" | "advertising" | "software" | "processing" | "content"
  // | "legal" | "other"
  category String
  vendor   String?
  amountCents Int
  note     String?
  incurredOn String // "YYYY-MM-DD"

  // Expenses that are not the agency's are not the agency's. Kept as a flag
  // rather than a separate table so a misfiled row can be corrected instead of
  // moved.
  agencyAttributable Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([period])
}

// Money out, to a creator.
model AgencyPayout {
  id        String        @id @default(cuid())
  creatorId String
  creator   AgencyCreator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  period      String // "YYYY-MM"
  amountCents Int

  // "pending" | "held" | "sent" | "failed" | "cancelled"
  //
  // "held" is the one that earns its place. A payout is held when the creator's
  // paperwork is incomplete or lapsed — see lib/agency/compliance.js — and the
  // hold is recorded with a reason so the creator can be told what is missing
  // rather than just not paid.
  status     String @default("pending")
  holdReason String?

  method    String?
  reference String? // transfer id / confirmation number
  sentAt    DateTime?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId, period])
  @@unique([creatorId, period])
}

// The 2.5% owed to InnerWifi for a month, and whether it went.
//
// One row per period, created when the month is closed. It stores the figures
// it was calculated from — not just the result — because the basis is the
// unresolved term in clause 4 ("Net Profit Share Of Agency Revenue" names two
// different numbers) and if that wording is ever settled, every past month has
// to be recomputable on the settled reading. A stored total alone could not be.
model AgencyRoyaltyRemittance {
  id     String @id @default(cuid())
  period String @unique // "YYYY-MM"

  // Which reading of clause 4 this was calculated on:
  // "net_profit" | "gross_revenue"
  basis String

  // The inputs, frozen. Covered revenue excludes accounts flagged
  // royaltyCovered = false.
  coveredRevenueCents Int
  coveredExpenseCents Int
  coveredProfitCents  Int
  rateBp              Int @default(250) // 250 bp = 2.50%
  amountCents         Int

  // What it WOULD have been on the other reading. The gap between these two is
  // the dollar value of an ambiguous clause, and seeing it monthly is what
  // makes fixing the wording feel urgent enough to actually do.
  alternateAmountCents Int

  status String @default("pending") // "pending" | "sent" | "disputed"
  sentAt DateTime?
  reference String?
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The two partners, and what each is owed.
//
// The residual split. Separate from AgencyPayout because a partner draw is not
// a creator payout: it comes last in the waterfall, out of what is left after
// the creators and InnerWifi have been paid, and it is the number both partners
// will check.
model AgencyPartnerDraw {
  id      String @id @default(cuid())
  period  String // "YYYY-MM"
  partner String // "david" | "owner" — matches AgencyPartner.key

  amountCents Int
  status      String @default("pending") // "pending" | "sent"
  sentAt      DateTime?
  reference   String?
  note        String?

  createdAt DateTime @default(now())

  @@unique([period, partner])
}

// Who the partners are and how the residual divides.
//
// A table rather than a constant because the split is a business agreement that
// can change, and because a change has to be datable: a draw computed in March
// under a 50/50 must still read as 50/50 after the split becomes 60/40 in June.
// AgencyPartnerDraw stores the resulting amount for exactly that reason.
model AgencyPartner {
  key       String @id // "david" | "owner"
  name      String
  email     String?
  shareBp   Int    // basis points of the residual; the set must total 10000
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row, id = "default". Settings that have to be stored somewhere and are
// not worth a table each.
model AgencySettings {
  id String @id @default("default")

  // WHICH READING OF CLAUSE 4 WE PAY ON.
  //
  // "net_profit" | "gross_revenue". Defaults to net_profit — the reading the
  // words "Net Profit Share" support — while the console shows both figures
  // and the gap, so the choice is a visible position rather than a silent
  // assumption. See docs/inner-wifi-agreement-review.md, item 1.
  royaltyBasis String @default("net_profit")
  royaltyRateBp Int   @default(250)
  // Set this if and when an addendum caps or ends the royalty. Null means the
  // obligation is perpetual, which is what was actually signed.
  royaltyEndsOn String?

  updatedAt DateTime @updatedAt
}
