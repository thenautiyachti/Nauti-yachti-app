# Every environment variable this application reads.
#
# It listed five for a long while and the application read twenty-five, which
# is the sort of gap you discover on the day you are rebuilding from nothing.
# `node scripts/secrets-inventory.js` prints where to get each one again.
#
# Copy to .env.local for development. Production values live in Vercel, and
# NOTHING here should ever hold a real value — it is committed.

# ---- Required: the app will not run without these -------------------------

# Postgres, from Supabase -> Project Settings -> Database.
DATABASE_URL=

# The owner console passcode, and the secret its session cookie is signed with.
ADMIN_PASSWORD=
SESSION_SECRET=

# ---- Taking money ---------------------------------------------------------

# Stripe -> Developers. The webhook secret is tied to the endpoint URL and is
# recreated whenever the endpoint is.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Sending mail ---------------------------------------------------------

RESEND_API_KEY=
FROM_EMAIL=The Nauti Yachti <bookings@thenautiyachti.com>
REPLY_TO_EMAIL=
OWNER_EMAIL=

# ---- The dock -------------------------------------------------------------

# The street address, sent in booking confirmations. Out of the repository
# because the dock is a private residence.
DOCK_ADDRESS=

# SENSITIVE. Read only by the admin-only Arriving tab, which writes the day-of
# text. lib/email.js deliberately cannot see it, so setting this can never mail
# the code to a guest. Never commit a real value: git history keeps it forever
# and rotating the code afterwards would not remove it.
DOCK_GATE_CODE=

# Fallback dock position for the weather page's run-home calculation.
#
# Mostly redundant now: each boat carries its own dockLat/dockLon, because the
# Explorer lives at Pearl Bay and the other two are three miles WSW — ten
# minutes apart at cruise, which in weather is the whole question. These are
# only used for a vessel with no dock recorded.
#
# Decimal degrees. The longitude is NEGATIVE in Texas; a dropped minus sign is
# rejected rather than believed, because it would otherwise put the dock in
# western China and report a 6,500-mile run home.
DOCK_LAT=
DOCK_LON=

CONTACT_PHONE=(832) 948-2912
# Optional. How early guests are asked to arrive; defaults to 15.
ARRIVE_MINUTES_EARLY=

# ---- Social ---------------------------------------------------------------

# blotato.com -> Settings -> API. Publishing, and reading the comments left on
# published posts for Marketing -> Comments. Facebook and Instagram only;
# TikTok comments are not exposed by the API.
BLOTATO_API_KEY=

# ---- Speech ---------------------------------------------------------------

# elevenlabs.io -> Profile. A 401 from this means QUOTA, not a bad key.
ELEVENLABS_API_KEY=
# Optional. Defaults to the flash model, which is half the price.
ELEVENLABS_MODEL_ID=
# Legacy single voice. lib/crew.js names each agent's voice instead, so this
# should not be needed.
ELEVENLABS_VOICE_ID=
# Optional guards on the speech endpoint.
JARVIS_SERVICE_KEY=
JARVIS_SPEECH_CAP=
SPEECH_AUDIO_KEEP_DAYS=

# ---- Not set by hand ------------------------------------------------------

# NODE_ENV and VERCEL_ENV are set by the platform.
#
# ALLOW_PROD_WRITES is the guard in lib/db.js. Scripts that intend to write to
# the live database set it themselves; never set it in an environment file, or
# every script loses the safety net.
