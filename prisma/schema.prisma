generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Package {
  id            String  @id
  name          String
  pricingType   String // "hourly-by-vessel" | "per-guest" | "tiered-by-guests" | "flat"
  unit          String?
  blurb         String
  bulletsIntro  String?
  bulletsJson   String? // JSON string: string[]
  closing       String?
  linkLabel     String?
  linkUrl       String?
  image         String?
  price         Float? // used when pricingType = "flat"
  pricePerGuest Float? // used when pricingType = "per-guest"
  fixedHours    Int? // used when pricingType = "per-guest" or "tiered-by-guests"
  eventDate     String? // used when pricingType = "per-guest" (e.g. Boatz & Glowz)
  tiersJson     String? // JSON string: { max: number, price: number }[]
  hourlyJson    String? // JSON string: { [vesselId]: { weekday: {...}, weekend: {...} } }
  vesselsJson   String // JSON string: string[] of vessel ids this package can use
  sortOrder     Int     @default(0)
}

model Vessel {
  id        String  @id
  slip      String
  name      String
  capacity  Int
  note      String
  image     String?
  sortOrder Int     @default(0)
}

model GalleryItem {
  id        String @id
  image     String
  caption   String
  category  String // matches a Package id
  sortOrder Int    @default(0)
}

model BlockedDate {
  id       String @id @default(cuid())
  vesselId String
  date     String // "YYYY-MM-DD"

  @@unique([vesselId, date])
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  packageId   String
  packageName String
  vesselId    String?
  vesselName  String?
  date        String?
  hours       Int?
  partySize   String?
  message     String?
  priceQuoted Float?
  status      String   @default("new") // "new" | "confirmed" | "declined"
  submittedAt DateTime @default(now())

  paymentStatus         String  @default("unpaid") // "unpaid" | "paid" | "refunded"
  stripeSessionId       String?
  stripePaymentIntentId String?

  couponCode     String? // uppercase Coupon.code, if one was applied at checkout
  discountAmount Float? // dollars knocked off priceQuoted by the coupon
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique // stored uppercase, e.g. "FAMILY20"
  discountType  String // "percent" | "fixed"
  discountValue Float // 20 means 20% for percent, or $20 for fixed
  active        Boolean  @default(true)
  maxUses       Int?
  usedCount     Int      @default(0)
  expiresAt     String? // "YYYY-MM-DD"
  note          String?
  createdAt     DateTime @default(now())
}

model Subscription {
  id           String   @id @default(cuid())
  name         String // e.g. "Boat storage", "design.com domain", "Claude subscription"
  category     String? // e.g. "Storage", "Hosting", "Software", "Utilities"
  amount       Float
  billingCycle String // "monthly" | "yearly" | "weekly"
  nextDueDate  String? // "YYYY-MM-DD"
  vendor       String?
  note         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model ExternalBooking {
  id         String   @id @default(cuid())
  vesselId   String
  vesselName String
  date       String // "YYYY-MM-DD"
  hours      Int? // charter length; used to gauge how much of the day is taken
  guestName  String?
  partySize  Int?
  platform   String // "Boatsetter" | "GetmyBoat" | "Facebook" | "Instagram" | "Other"
  status     String   @default("pending") // "pending" | "confirmed"
  note       String?
  createdAt  DateTime @default(now())
}

model AddOn {
  id        String  @id
  name      String
  price     Float
  unit      String? // e.g. "per charter", "per bottle"
  blurb     String?
  sortOrder Int     @default(0)
}

model LedgerEntry {
  id        String   @id @default(cuid())
  type      String // "income" | "expense"
  category  String? // e.g. "01. Gas" (expense) or "Reservation" (income)
  amount    Float
  note      String?
  origin    String? // reservation origin (Boatsetter, GetmyBoat, ...) or statement source (Cash, Wells Fargo Statement, ...)
  bookingId String? // links an expense back to the reservation it was for
  date      String
  createdAt DateTime @default(now())
}

model MaintenanceItem {
  id             String  @id @default(cuid())
  label          String
  intervalHours  Int?
  intervalMonths Int?
  lastDoneDate   String? // "YYYY-MM-DD"
  lastDoneHours  Float?
  notes          String?
  sortOrder      Int     @default(0)
}

model EngineHoursLog {
  id        String   @id @default(cuid())
  vesselId  String
  date      String // "YYYY-MM-DD"
  hours     Float // hour-meter reading at that point, not a duration
  note      String?
  createdAt DateTime @default(now())
}

model FuelLog {
  id            String   @id @default(cuid())
  vesselId      String
  date          String // "YYYY-MM-DD"
  hoursAtFillup Float?
  gallons       Float?
  cost          Float?
  note          String?
  createdAt     DateTime @default(now())
}

model MediaDraft {
  id         String    @id @default(cuid())
  theme      String // e.g. package name or "General" this draft is themed around
  mediaUrl   String // URL of the generated image or video
  mediaType  String    @default("image") // "image" | "video"
  caption    String // Drafted social caption text
  platform   String? // intended platform, e.g. "instagram", "facebook", "tiktok" — nullable, may be undecided
  status     String    @default("pending") // "pending" | "approved" | "rejected" | "posted"
  reviewNote String? // optional owner note when approving/rejecting
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
}

model SpeechEvent {
  id        String   @id @default(cuid())
  text      String // the text that was spoken
  audioB64  String // ElevenLabs mp3 output, base64-encoded
  createdAt DateTime @default(now())
}
