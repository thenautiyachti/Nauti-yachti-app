generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Package {
  id            String  @id
  name          String
  pricingType   String // "hourly-by-vessel" | "per-guest" | "tiered-by-guests" | "flat"
  unit          String?
  blurb         String
  bulletsIntro  String?
  bulletsJson   String? // JSON string: string[]
  closing       String?
  linkLabel     String?
  linkUrl       String?
  image         String?
  price         Float? // used when pricingType = "flat"
  pricePerGuest Float? // used when pricingType = "per-guest"
  fixedHours    Int? // used when pricingType = "per-guest" or "tiered-by-guests"
  eventDate     String? // used when pricingType = "per-guest" (e.g. Boatz & Glowz)
  tiersJson     String? // JSON string: { max: number, price: number }[]
  hourlyJson    String? // JSON string: { [vesselId]: { weekday: {...}, weekend: {...} } }
  vesselsJson   String // JSON string: string[] of vessel ids this package can use
  sortOrder     Int     @default(0)
}

// Audit trail for Packages & Pricing changes — internal only, never shown
// on the public site. Lets the owner investigate a pricing discrepancy
// after the fact (what changed, from what, to what, when).
model PriceChangeLog {
  id          String   @id @default(cuid())
  packageId   String
  packageName String // denormalized snapshot — stays readable even if the package is later renamed
  field       String // human-readable description, e.g. "Flat price", "Per-guest price", "Nauti Explorer / weekend / 4hr", "Tier 2 (13-16 guests)"
  oldValue    Float?
  newValue    Float
  changedAt   DateTime @default(now())
}

model Vessel {
  id        String  @id
  slip      String
  name      String
  capacity  Int
  note      String
  image     String?
  sortOrder Int     @default(0)
}

model GalleryItem {
  id        String @id
  image     String
  caption   String
  category  String // matches a Package id
  sortOrder Int    @default(0)
}

model BlockedDate {
  id       String @id @default(cuid())
  vesselId String
  date     String // "YYYY-MM-DD"

  @@unique([vesselId, date])
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String
  packageId   String
  packageName String
  vesselId    String?
  vesselName  String?
  date        String?
  hours       Int?
  partySize   String?
  message     String?
  priceQuoted Float?
  status      String   @default("new") // "new" | "lapsed" | "pending" | "booked" | "completed" | "cancelled"
  submittedAt DateTime @default(now())

  paymentStatus         String  @default("unpaid") // "unpaid" | "paid" | "refunded"
  stripeSessionId       String?
  stripePaymentIntentId String?

  // Only meaningful when status is "cancelled" — how a confirmed booking's
  // payment was resolved on cancellation. Independent of paymentStatus
  // (which is the raw Stripe-driven unpaid/paid/refunded signal); this
  // captures the owner's own record of what actually happened.
  refundType   String? // "full" | "partial" | "none"
  refundAmount Float? // dollar amount actually refunded — mainly for "partial"

  couponCode     String? // uppercase Coupon.code, if one was applied at checkout
  discountAmount Float? // dollars knocked off priceQuoted by the coupon

  // Gift certificate applied at checkout, after any coupon. giftAmount is the
  // dollars drawn off the certificate for this booking.
  giftCertificateCode String?
  giftAmount          Float?

  // Format "NY-YYYYMMDD-NN" — assigned at creation time going forward only.
  // Historical rows are intentionally left null (never backfilled) — see
  // lib/bookingId.js for the generator.
  bookingId String? @unique

  addOnIds String? // JSON string: string[] of AddOn ids selected at booking
  reviewRequestedAt DateTime? // when a Google review was asked for; null = not yet asked
}

model Coupon {
  id                    String   @id @default(cuid())
  code                  String   @unique // stored uppercase, e.g. "FAMILY20"
  discountType          String // "percent" | "fixed"
  discountValue         Float // 20 means 20% for percent, or $20 for fixed
  active                Boolean  @default(true)
  maxUses               Int?
  usedCount             Int      @default(0)
  expiresAt             String? // "YYYY-MM-DD"
  note                  String?
  requiresReturningGuest Boolean @default(false) // if true, checkCoupon() only accepts this code for an email with a prior paid Inquiry
  archived              Boolean  @default(false) // soft-delete — removed from the main admin list into an Archived section, restorable
  createdAt             DateTime @default(now())
}

model Subscription {
  id           String   @id @default(cuid())
  name         String // e.g. "Boat storage", "design.com domain", "Claude subscription"
  category     String? // e.g. "Storage", "Hosting", "Software", "Utilities"
  amount       Float
  billingCycle String // "monthly" | "yearly" | "weekly"
  nextDueDate  String? // "YYYY-MM-DD"
  vendor       String?
  note         String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model ExternalBooking {
  id         String   @id @default(cuid())
  vesselId   String
  vesselName String
  date       String // "YYYY-MM-DD"
  startTime  String? // "HH:MM" 24-hour, e.g. "10:00" — when the charter starts
  hours      Int? // charter length; used to gauge how much of the day is taken
  guestName  String?
  email      String? // guest email, when known — Boatsetter/GetMyBoat rarely expose a real one
  partySize  Int?
  platform   String // "Boatsetter" | "GetmyBoat" | "Facebook" | "Instagram" | "Other"
  status     String   @default("booked") // "booked" | "completed" | "cancelled"
  note       String?
  createdAt  DateTime @default(now())

  pricePaid Float? // what the guest actually paid, if the owner has logged it

  phone           String?  // guest phone, when known
  platformRef     String?  // the platform's own reservation number (Boatsetter/GetMyBoat) - shared key with LedgerEntry
  referralSource  String?  // how the booking was won: "repeat guest", "word of mouth", "website", "walk-up" - distinct from `platform`, which is who processed it
  reviewRequestedAt DateTime? // when a Google review was asked for; null = not yet asked
  marketingOptOut Boolean  @default(false)
  ledgerEntries   LedgerEntry[]

  // Format "NY-YYYYMMDD-NN" — assigned at creation time going forward, and
  // backfilled once (2026-08-29) for historical rows so every booking has one.
  bookingId String? @unique
}

model AddOn {
  id        String  @id
  name      String
  price     Float
  unit      String? // e.g. "per charter", "per bottle"
  blurb     String?
  sortOrder Int     @default(0)
  active    Boolean @default(true) // false = hidden from the public site (e.g. temporarily out of stock) but still manageable in the admin console
  archived  Boolean @default(false) // true = removed from the main admin list into the Archived section; also implies hidden from the public site
}

model LedgerEntry {
  id          String   @id @default(cuid())
  type        String // "income" | "expense"
  category    String? // e.g. "01. Gas" (expense) or "Reservation" (income)
  subcategory String? // vessel/package name for income rows, e.g. "The Nauti Explorer" — null for expenses
  amount      Float
  grossAmount Float? // income rows only: the platform's gross/list price before its commission — amount is what was actually paid out. Nullable/optional; not used for expenses.
  note        String?
  origin      String? // reservation origin (Boatsetter, GetmyBoat, ...) or statement source (Cash, Wells Fargo Statement, ...)
  bookingId   String? // links an expense back to the reservation it was for
  externalBookingId String? // real FK to ExternalBooking.id - the reliable join the bookingId string never provided
  externalBooking   ExternalBooking? @relation(fields: [externalBookingId], references: [id], onDelete: SetNull)
  date        String
  createdAt   DateTime @default(now())
}

model MaintenanceItem {
  id             String  @id @default(cuid())
  label          String
  intervalHours  Int?
  intervalMonths Int?
  lastDoneDate   String? // "YYYY-MM-DD"
  lastDoneHours  Float?
  notes          String?
  sortOrder      Int     @default(0)
}

model EngineHoursLog {
  id        String   @id @default(cuid())
  vesselId  String
  date      String // "YYYY-MM-DD"
  hours     Float // hour-meter reading at that point, not a duration
  note      String?
  createdAt DateTime @default(now())
}

model FuelLog {
  id            String   @id @default(cuid())
  vesselId      String
  date          String // "YYYY-MM-DD"
  hoursAtFillup Float?
  gallons       Float?
  cost          Float?
  note          String?
  createdAt     DateTime @default(now())
}

model MediaDraft {
  // One social pipeline: proposed -> approved -> scheduled -> posted.
  // Previously this table held only agent-proposed drafts while a separate
  // CampaignPost table held scheduled copy, so approving a draft was a dead
  // end - it set a flag and nothing carried it to a date. Both halves now live
  // here, which also leaves the media-agent cron POSTing to /api/media-drafts
  // working unchanged.
  id         String    @id @default(cuid())
  theme      String // package name or "General" this is themed around
  mediaUrl   String? // null for a written-in-advance campaign post with no image yet
  mediaType  String    @default("image") // "image" | "video"
  caption    String // Drafted social caption text
  platform   String? // intended platform, e.g. "instagram", "facebook", "tiktok" — nullable, may be undecided
  status     String    @default("proposed") // pipeline stage: "proposed" | "approved" | "scheduled" | "posted" | "rejected"
  reviewNote String? // optional owner note when approving/rejecting
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  // Scheduling half of the pipeline, merged in from CampaignPost.
  campaign      String? // e.g. "boatz-and-glowz-2026-09"; null for a one-off
  postNumber    Int? // ordering within a campaign
  title         String? // the beat, e.g. "FINAL CALL"
  scheduledDate String? // "YYYY-MM-DD" once it has a slot
  scheduledTime String? // "6:30 PM"
  photoHint     String? // which real photo to use
  deliveryNote  String? // e.g. "post natively - Blotato cannot do IG stills"
  postedAt      DateTime?
  postUrl       String?

  @@index([campaign, scheduledDate])
  @@index([status])
}

model Testimonial {
  id              String    @id @default(cuid())
  name            String
  rating          Int // 1-5
  quote           String
  packageOrVessel String? // e.g. "Party Cove on the Nauti Yachti" — optional
  status          String    @default("pending") // "pending" | "approved" | "rejected"
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
}

model SpeechEvent {
  id        String   @id @default(cuid())
  text      String // the text that was spoken
  audioB64  String? // ElevenLabs mp3 output, base64-encoded; null when synthesis failed (quota) and only the text was kept
  createdAt DateTime @default(now())
}

model AgentActivity {
  id          String    @id @default(cuid())
  agentName   String // e.g. "Claude Code", "Media Agent"
  taskTitle   String
  status      String    @default("running") // "running" | "completed" | "failed"
  detail      String? // free text — a short progress note or result summary
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model JarvisTodo {
  id        String    @id @default(cuid())
  text      String
  priority  String    @default("medium") // "low" | "medium" | "high"
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  doneAt    DateTime?
}

// Prepaid money with a depleting balance — deliberately NOT a Coupon. A coupon
// is a discount rule; a gift certificate is cash taken up front for a service
// still owed, which makes an unredeemed balance a liability rather than income.
model GiftCertificate {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "NY-GIFT-7QK4M2", stored uppercase
  initialAmount   Float // face value at issue
  balance         Float // what is left; a certificate can be part-redeemed
  purchaserName   String?
  purchaserEmail  String?
  purchaserPhone  String?
  recipientName   String?
  message         String? // the note that goes on the printed certificate
  status          String   @default("active") // "active" | "redeemed" | "void"
  expiresAt       String? // "YYYY-MM-DD"; null means no expiry
  stripeSessionId String? // set when bought online rather than issued by hand
  note            String?
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  redemptions GiftCertificateRedemption[]
}

// One row per draw-down, so a balance can always be explained rather than
// merely asserted — the difference between "it says $50" and "here is where
// the other $450 went".
model GiftCertificateRedemption {
  id            String   @id @default(cuid())
  certificateId String
  certificate   GiftCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  amount        Float
  bookingId     String? // the booking it was applied to, when known
  note          String?
  redeemedAt    DateTime @default(now())
}

// A scheduled social post, one row per post AND platform.
//
// Split per platform rather than one row carrying three captions, because each
// goes out separately: Blotato cannot push a still image to the Instagram feed,
// so IG stills are posted by hand while Facebook goes through the API. A single
// status per post would hide "done on Facebook, still owed on Instagram".
model CampaignPost {
  id            String    @id @default(cuid())
  campaign      String // e.g. "boatz-and-glowz-2026-09"
  postNumber    Int // ordering within the campaign
  scheduledDate String // "YYYY-MM-DD"
  scheduledTime String? // "6:30 PM"
  title         String?
  platform      String // "Facebook" | "Instagram" | "TikTok"
  body          String // the caption, ready to copy
  photoHint     String? // which real photo to use
  deliveryNote  String? // e.g. "post natively - Blotato cannot do IG stills"
  status        String    @default("pending") // "pending" | "posted" | "skipped"
  postedAt      DateTime?
  postUrl       String?
  createdAt     DateTime  @default(now())

  @@index([campaign, scheduledDate])
}
