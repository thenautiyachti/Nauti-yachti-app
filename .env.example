# Local dev default (SQLite file). For production, point this at a real
# Postgres database instead — e.g. a connection string from Supabase or
# Vercel Postgres — and change the "provider" in prisma/schema.prisma
# from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# The passcode the owner console login checks against. Change this to
# something only you know before deploying.
ADMIN_PASSWORD="change-me"

# A long random string used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: set this to enable real inquiry emails via Resend
# (https://resend.com). Leave blank during local testing — inquiries
# still save to the database either way, and are logged to the server
# console instead of emailed.
RESEND_API_KEY=""

# Where inquiry emails should be sent once RESEND_API_KEY is set.
OWNER_EMAIL="bookings@thenautiyachti.com"
